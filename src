// Synthetic requests only. These are not patient records.
export const requests = [
  {id:'REQ-101', type:'Visit summary', unit:'General clinic', status:'Processing', identity:'verified', authorisation:'verified'},
  {id:'REQ-102', type:'Attendance letter', unit:'Dental clinic', status:'Processing', identity:'unverified', authorisation:'verified'},
  {id:'REQ-103', type:'Visit summary', unit:'General clinic', status:'Processing', identity:'verified', authorisation:'pending'},
  {id:'REQ-104', type:'Referral copy', unit:'Dental clinic', status:'Collected', identity:'verified', authorisation:'verified'},
  {id:'REQ-105', type:'Attendance letter', unit:'General clinic', status:'Collected', identity:'verified', authorisation:'verified'},
  {id:'REQ-106', type:'Referral copy', unit:'General clinic', status:'Cancelled', identity:'unverified', authorisation:'pending'}
];

// Implement the supplied classroom requirements here, with your chosen AI harness.
export function filterRequests(requests, {status = 'All', query = ''} = {}) {
  // Starter: displays all rows. Filtering and search are your Cycle 1 task.
  return requests.slice();
}

export function transitionRequest(requests, id, nextStatus, actor, {reason = ''} = {}) {
  const currentRequest = requests.find(item => item.id === id);

  if (!currentRequest) {
    return { ok: false, requests, error: 'Request not found.' };
  }

  const trimmedActor = actor.trim();

  if (!trimmedActor) {
    return { ok: false, requests, error: 'Staff alias is required.' };
  }

  const allowedTransitions = {
    'Awaiting review': ['Processing', 'Cancelled'],
    'Processing': ['Ready', 'Cancelled'],
    'Ready': ['Collected', 'Cancelled'],
    'Collected': [],
    'Cancelled': []
  };

  if (!allowedTransitions[currentRequest.status]?.includes(nextStatus)) {
    return {
      ok: false,
      requests,
      error: 'This status transition is not allowed.'
    };
  }

  if (
    nextStatus === 'Ready' &&
    (currentRequest.identity !== 'verified' ||
      currentRequest.authorisation !== 'verified')
  ) {
    return {
      ok: false,
      requests,
      error: 'Identity and authorisation must both be verified before marking Ready.'
    };
  }

  const trimmedReason = reason.trim();

  if (nextStatus === 'Cancelled' && trimmedReason.length < 10) {
    return {
      ok: false,
      requests,
      error: 'Cancellation reason must be at least 10 characters.'
    };
  }

  const updatedRequest = {
    ...currentRequest,
    status: nextStatus
  };

  const updatedRequests = requests.map(item =>
    item.id === id ? updatedRequest : item
  );

  const event = {
    requestId: id,
    from: currentRequest.status,
    to: nextStatus,
    actor: trimmedActor,
    at: new Date().toISOString(),
    ...(nextStatus === 'Cancelled' ? { reason: trimmedReason } : {})
  };

  return {
    ok: true,
    requests: updatedRequests,
    event
  };
}

import {requests as seed} from './fixtures.js';
import {filterRequests, transitionRequest} from './tracker.js';
let state = structuredClone(seed);
const byId = id => document.getElementById(id);

function render() {
  const visible = filterRequests(state, {status: byId('status').value, query: byId('query').value});
  byId('rows').replaceChildren();
  for (const item of visible) {
    const row = document.createElement('tr');
    for (const key of ['id','type','unit','status','identity','authorisation']) {
      const cell = document.createElement('td');
      cell.textContent = item[key];
      row.append(cell);
    }
    byId('rows').append(row);
  }
  byId('count').textContent = `${visible.length} of ${state.length} requests shown`;
  byId('empty').hidden = visible.length !== 0;
}

for (const item of state) {
  const option = document.createElement('option');
  option.value = item.id;
  option.textContent = item.id;
  byId('request-id').append(option);
}
byId('status').addEventListener('change', render);
byId('query').addEventListener('input', render);
byId('update').addEventListener('submit', e => {
  e.preventDefault();

  const reason = byId('cancellation-reason').value;

  const result = transitionRequest(
    state,
    byId('request-id').value,
    byId('next-status').value,
    byId('actor').value,
    { reason }
  );

  if (!result.ok) {
    byId('message').textContent = result.error;
    return;
  }
  state = result.requests;
  byId('message').textContent = 'Status updated.';
  const event = result.event;
  const item = document.createElement('li');
  item.textContent = `${event.requestId}: ${event.from} → ${event.to} by ${event.actor} at ${event.at}${event.reason ? ' (' + event.reason + ')' : ''}`;
  byId('audit').append(item);
  render();
});
render();
